    "@types/bun": "^1.2.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wrangler": "^4.158.0"
  },
  "dependencies": {
    "@oddbird/popover-polyfill": "^0.5.0"
  }
